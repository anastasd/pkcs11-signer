{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-read",
    {
      "identifier": "fs:scope",
      "allow": [
        "$DESKTOP/*",
        "$DESKTOP/**/*"
      ]
    },
    "fs:allow-desktop-write",
    "fs:allow-appdata-write",
    "fs:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "pkcs11-tool",
          "cmd": "pkcs11-tool",
          "args": true
        }
      ]
    },
    "shell:default"
  ]
}